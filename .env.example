# ==========================================================================
# TimeLabs × Mendes & Vaz — Variáveis de ambiente
# Copie este arquivo para .env e preencha com as chaves reais.
# O .env NUNCA deve ser commitado (já está no .gitignore).
# ==========================================================================

# --- Geração de copy (OpenAI / Groq / DeepSeek) ---
# Substituímos a Claude API pela OpenAI nesta fase (sem chave Anthropic).
# Groq e DeepSeek são compatíveis com o SDK da OpenAI: cole a chave do
# provedor escolhido aqui e descomente o OPENAI_BASE_URL correspondente.
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1      # Groq (gratuito, ver console.groq.com)
# OPENAI_BASE_URL=https://api.deepseek.com             # DeepSeek (pago)

# --- Geração de arte (Ideogram ou Pollinations.ai) ---
# IMAGE_PROVIDER escolhe o gerador: "ideogram" (default, pago) ou
# "pollinations" (gratuito, sem chave — bom pra testar sem budget).
# IMAGE_PROVIDER=pollinations

IDEOGRAM_API_KEY=

# Opcional: força placeholders mesmo tendo credencial (debug/economia).
# Padrão (linha ausente ou false): usa o provedor real quando há credencial.
# USE_MOCK_IMAGES=false

# --- (Fase 2 — Buffer) ---
# BUFFER_ACCESS_TOKEN=...
# BUFFER_PROFILE_ID_INSTAGRAM=...
# BUFFER_PROFILE_ID_LINKEDIN=...

# --- (Fase 3 — Evolution API / WhatsApp — responsabilidade do Francisco) ---
# EVOLUTION_API_URL=...
# EVOLUTION_API_KEY=...
# EVOLUTION_INSTANCE=...
